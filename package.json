{
  "name": "labucs-poc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LabUcs — POC de gestão de equipamentos laboratoriais com frontend e backend separados, 100% estática e compatível com GitHub Pages.",
  "scripts": {
    "dev": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "importar": "node scripts/importar-base-real.js",
    "inspecionar": "node scripts/inspecionar.js",
    "vendorizar": "node scripts/vendorizar.js",
    "lint:css": "stylelint \"src/frontend/**/*.css\"",
    "lint:css:fix": "stylelint \"src/frontend/**/*.css\" --fix",
    "lint": "npm run lint:css",
    "a11y": "node scripts/inspecionar.js --auditar"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "chart.js": "^4.6.1",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.12",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^37.0.0"
  }
}
